[Unit]
Description=Care Reach SO-101 dashboard (Pi-owned serial bus)

[Service]
Type=simple
WorkingDirectory=/home/robot/worktrees/care-reach/arm-runtime-main-20261025
Environment=PYTHONPATH=/home/robot/worktrees/care-reach/lerobot-runtime-src:/home/robot/worktrees/care-reach/lerobot-runtime-src/src
ExecStartPre=/usr/bin/test -e /dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79078563-if00
ExecStart=/home/robot/worktrees/care-reach/pi-runtime/.venv/bin/python -u /home/robot/worktrees/care-reach/arm-runtime-main-20261025/server.py --port /dev/serial/by-id/usb-1a86_USB_Single_Serial_5B79078563-if00 --http-host 0.0.0.0 --http-port 8765
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
